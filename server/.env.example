# Server
PORT=4000
NODE_ENV=development

# Frontend origin allowed to call this API (Vite dev server default)
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string
# Create a free M0 cluster at https://www.mongodb.com/cloud/atlas/register,
# add a database user + allow your IP (or 0.0.0.0/0 for dev), then copy the connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lld-practice

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# AI feedback provider (Groq). Leave unset to use the deterministic mock provider.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
